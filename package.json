{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "init": "tsx scripts/portfolio-setup.mts init",
    "update": "tsx scripts/portfolio-setup.mts update",
    "validate:resume": "tsx scripts/validate-resume-data.mts",
    "validate:resume:strict": "tsx scripts/validate-resume-data.mts --strict-assets",
    "postinstall": "tsx scripts/setup-husky.mts",
    "check:repo-hygiene": "tsx scripts/check-repo-hygiene.mts",
    "check:file-budgets": "tsx scripts/check-file-budgets.mts",
    "check:bundle-budget": "tsx scripts/check-bundle-budget.mts",
    "analyze:bundle": "tsx scripts/analyze-bundle.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:health": "tsx scripts/run-typecheck-with-health.mts",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "quality": "npm run check:repo-hygiene && npm run check:file-budgets && npm run validate:resume:strict && npm run format:check && npm run typecheck && npm run lint && npm run test",
    "precommit": "lint-staged",
    "prepush": "tsx scripts/run-prepush-quality.mts",
    "prepr": "npm run quality",
    "dev": "NEXT_TURBOPACK=1 next dev --turbopack",
    "build": "NEXT_TURBOPACK=1 next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx scripts/run-jest-with-health.mts --suite unit",
    "test:a11y": "tsx scripts/run-jest-with-health.mts --suite a11y"
  },
  "lint-staged": {
    "{src,scripts}/**/*.{js,jsx,ts,tsx,mjs,cjs,mts}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx,mjs,cjs,mts}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,scss,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/utilities": "^3.2.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.0.13",
    "@mui/icons-material": "^6.5.0",
    "@mui/lab": "^6.0.1-beta.36",
    "@mui/material": "^6.5.0",
    "autoprefixer": "^10.4.27",
    "bio-parsers": "^9.3.6",
    "dnaviz": "^1.1.1",
    "dompurify": "^3.0.6",
    "konva": "^10.2.0",
    "lodash": "^4.17.21",
    "marked": "^12.0.2",
    "matter-js": "^0.20.0",
    "mermaid": "^11.10.0",
    "next": "15.5.15",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.1.392",
    "postcss": "^8.5.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-konva": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-refresh": "^0.11.0",
    "recharts": "^2.10.3",
    "tailwindcss": "^4.2.1",
    "uuid": "^11.1.0",
    "ve-range-utils": "^2.6.6",
    "ve-sequence-utils": "^5.2.16",
    "web-vitals": "^2.1.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.12",
    "@types/jest-axe": "^3.5.9",
    "@types/lodash": "^4.17.20",
    "@types/matter-js": "^0.20.0",
    "@types/node": "^20",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "jsondiffpatch": "0.7.3"
  }
}
